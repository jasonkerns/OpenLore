{
  "family": "openspec-setupcode",
  "requiresCompatibilities": ["FARGATE"],
  "networkMode": "awsvpc",
  "cpu": "256",
  "memory": "512",
  "runtimePlatform": { "operatingSystemFamily": "LINUX", "cpuArchitecture": "X86_64" },
  "executionRoleArn": "arn:aws:iam::530733533303:role/ecsTaskExecutionRole",
  "containerDefinitions": [
    {
      "name": "openspec-setupcode",
      "image": "530733533303.dkr.ecr.us-east-1.amazonaws.com/openspec:latest",
      "essential": true,
      "entryPoint": ["openlore"],
      "command": ["harness", "setup-code", "--config", "/data/openlore.yml", "--ttl", "1h"],
      "mountPoints": [
        { "sourceVolume": "data", "containerPath": "/data", "readOnly": false }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/openspec",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "setup"
        }
      }
    }
  ],
  "volumes": [
    {
      "name": "data",
      "efsVolumeConfiguration": {
        "fileSystemId": "fs-09d0ff58ec048819c",
        "transitEncryption": "ENABLED",
        "authorizationConfig": {
          "accessPointId": "fsap-0af965cbfea70eaac",
          "iam": "DISABLED"
        }
      }
    }
  ]
}
